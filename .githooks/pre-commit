#!/bin/sh
# Deterministic pre-commit gate: formatting + tests must pass before a commit lands.
#
# This is the hard, unskippable backstop for the *deterministic* checks. The LLM-side reviews — domain /
# Gen-1 fidelity (`requirements-review`) and technical + generation-seam architecture (`pr-review`) — run in
# the main session before commit; a shell hook can't launch a subagent, so the pieces work together.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in a genuine emergency:  git commit --no-verify  (don't make a habit of it)

DOTNET="C:/Users/USER/.dotnet/dotnet.exe"

# Gate 2 (CLAUDE.md > Process gates): docs-cleanup must have run LAST. Its final act writes the stamp; a staged
# file modified after the stamp means something changed since, so it must run again. Human-only bypass:
# DOCS_CLEANUP_BYPASS=1. The AI assistant must never set it or forge the stamp.
GIT_DIR=$(git rev-parse --git-dir)
STAMP="$GIT_DIR/docs-cleanup.stamp"
if [ -n "$DOCS_CLEANUP_BYPASS" ]; then
  echo "[pre-commit] WARNING: docs-cleanup gate bypassed (DOCS_CLEANUP_BYPASS)." >&2
elif [ -f "$GIT_DIR/MERGE_HEAD" ]; then
  echo "[pre-commit] Merge commit - docs-cleanup gate skipped."
elif [ ! -f "$STAMP" ]; then
  echo "[pre-commit] BLOCKED: docs-cleanup has not run (no stamp). It is the mandatory LAST gate for every change." >&2
  exit 1
else
  STALE=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
    [ "$f" -nt "$STAMP" ] && echo "  $f"
  done)
  if [ -n "$STALE" ]; then
    echo "[pre-commit] BLOCKED: staged files changed after docs-cleanup ran - run it again:" >&2
    echo "$STALE" >&2
    exit 1
  fi
  echo "[pre-commit] docs-cleanup stamp is current."
fi

echo "[pre-commit] CSharpier format check..."
if ! "$DOTNET" csharpier check . ; then
  echo "[pre-commit] BLOCKED: code is not CSharpier-formatted. Run: dotnet csharpier format ." >&2
  exit 1
fi

# No --diff-filter: deletes and renames must trigger the gates too.
DOTNET_TRIGGER='\.(cs|csproj|props|db)$|(^|/)global\.json$'
TS_TRIGGER='\.tsx?$|(^|/)package(-lock)?\.json$|(^|/)tsconfig[^/]*\.json$'

if git diff --cached --name-only | grep -qE "$DOTNET_TRIGGER"; then
  echo "[pre-commit] .NET-affecting changes staged — running the .NET test suite..."
  if ! "$DOTNET" test tests/creaturegame.Tests --nologo ; then
    echo "[pre-commit] BLOCKED: tests failed. Fix them before committing." >&2
    exit 1
  fi
else
  echo "[pre-commit] No .NET-affecting changes staged — skipping the test suite."
fi

# The TypeScript mirror of the .cs rule above. Vitest transpiles via esbuild, which strips types WITHOUT
# checking them, so without this a type error passes every gate and lands — `tsc` otherwise runs only in
# `npm run build`. tsconfig covers src/ + e2e/ and takes ~6s.
if git diff --cached --name-only | grep -qE "$TS_TRIGGER"; then
  echo "[pre-commit] Frontend-affecting changes staged — typechecking the frontend..."
  if [ ! -d creaturegame.Web/ClientApp/node_modules ]; then
    echo "[pre-commit] BLOCKED: creaturegame.Web/ClientApp/node_modules is missing, so the staged" >&2
    echo "            TypeScript cannot be checked. Run: cd creaturegame.Web/ClientApp && npm install" >&2
    exit 1
  fi
  if ! ( cd creaturegame.Web/ClientApp && npm run --silent typecheck ) ; then
    echo "[pre-commit] BLOCKED: TypeScript type errors. Fix them before committing." >&2
    exit 1
  fi
else
  echo "[pre-commit] No frontend-affecting changes staged — skipping the frontend typecheck."
fi

echo "[pre-commit] OK."
